<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Segoe UI', sans-serif;
  color: #f5f5f5;
  background:
    radial-gradient(circle at 15% 50%, rgba(255,215,150,0.12), rgba(0,0,0,0) 45%),
