  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.card {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
  border-radius: 22px;
  padding: 32px 24px;
  max-width: 420px;
  width: 100%;
  box-shadow: 0 25px 60px rgba(0,0,0,0.6);
  text-align: center;
}

h1 {
  font-size: 22px;
  font-weight: 500;
  margin-bottom: 26px;
}

.versiculo { font-size: 19px; line-height: 1.6; margin-bottom: 12px; }
.referencia { font-size: 14px; opacity: 0.85; margin-bottom: 20px; }
.aplicacao { font-size: 15px; font-style: italic; opacity: 0.95; margin-bottom: 28px; }
.pergunta { font-size: 15px; margin-bottom: 14px; opacity: 0.9; }

.opcoes button {
  width: 100%; padding: 13px; margin: 8px 0;
  border-radius: 30px; border: 1px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03); color: #f5f5f5;
  font-size: 14px; cursor: pointer; transition: 0.2s ease;
}
.opcoes button:hover { background: rgba(255,255,255,0.08); transform: scale(1.02); }

.agradecimento { margin-top: 18px; font-size: 14px; display: none; opacity: 0.9; }
.contador { margin-top: 30px; font-size: 13px; opacity: 0.75; }
</style>
</head>

